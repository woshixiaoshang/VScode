means = {k: [] for k in ratio_keys}
sds   = {k: [] for k in ratio_keys}
ns    = []

for group in groups:
    ns.append(parsed_data[group]["N"])
    for key in ratio_keys:
        means[key].append(parsed_data[group].get(key, {"mean": 0})["mean"])
        sds[key].append(parsed_data[group].get(key, {"sd": 0})["sd"])

# ─────────────────────────────────────────────
# 4. 自动统计显著性检验 (T-test)
# ─────────────────────────────────────────────
def get_stars(p_val):
    if p_val < 0.001: return "***"
    elif p_val < 0.01: return "**"
    elif p_val < 0.05: return "*"
    else: return "ns"

def get_p_value(group_idx1, group_idx2, ratio_key):
    """基于 Mean, SD 和 N 计算两独立样本 T 检验的 P 值"""
    m1, s1, n1 = means[ratio_key][group_idx1], sds[ratio_key][group_idx1], ns[group_idx1]
    m2, s2, n2 = means[ratio_key][group_idx2], sds[ratio_key][group_idx2], ns[group_idx2]
    
    if s1 == 0 or s2 == 0: return 1.0 # 避免假数据报错
    
    _, p = ttest_ind_from_stats(mean1=m1, std1=s1, nobs1=n1,
                                mean2=m2, std2=s2, nobs2=n2,
                                equal_var=False) # Welch's t-test
    return p

