# ─────────────────────────────────────────────
# 2. 自动读取与解析 txt 文件
# ─────────────────────────────────────────────
def parse_summary_file(filepath):
    """解析 txt 文件，提取样本数 N，以及各比值的 Mean 和 SD"""
    with open(filepath, 'r', encoding='utf-8') as f:
        content = f.read()
    
    # 提取样本数 N
    n_match = re.search(r'有效光谱数:\s+(\d+)', content)
    n = int(n_match.group(1)) if n_match else 100 # 找不到默认给100
    
    data = {"N": n}
    
    # 按【Ratio: 切割文本块
    blocks = content.split('【Ratio: ')
    for block in blocks[1:]: # 第0个是开头
        ratio_name = block.split('】')[0].strip()
        
        mean_match = re.search(r'均值:\s+([0-9.]+)', block)
        sd_match = re.search(r'标准差\(SD\):\s+([0-9.]+)', block)
        
        if mean_match and sd_match:
            data[ratio_name] = {
                'mean': float(mean_match.group(1)),
                'sd': float(sd_match.group(1))
            }
    return data

print("🚀 正在自动读取各组的高波数统计摘要...")
